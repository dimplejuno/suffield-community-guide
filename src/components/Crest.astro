---
// Original crest mark inspired by the Town of Suffield's blue + gold seal.
// Deliberately NOT a copy of the official municipal seal.
const { size = 42 } = Astro.props;
---
<svg class="crest" width={size} height={size} viewBox="0 0 100 100" role="img" aria-label="Suffield Community Guide crest" set:html={`
  <defs>
    <linearGradient id="crestShield" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3f77b3"/>
      <stop offset="1" stop-color="#1c3f63"/>
    </linearGradient>
  </defs>
  <circle cx="50" cy="50" r="48" fill="#1c3f63"/>
  <circle cx="50" cy="50" r="46" fill="none" stroke="#c9a227" stroke-width="1.5"/>
  <circle cx="50" cy="50" r="38" fill="#f7f5ef"/>
  <!-- shield -->
  <path d="M50 24 L72 32 L72 54 C72 68 62 76 50 82 C38 76 28 68 28 54 L28 32 Z" fill="url(#crestShield)" stroke="#c9a227" stroke-width="2"/>
  <!-- gold sun -->
  <circle cx="50" cy="50" r="10" fill="#c9a227"/>
  <g stroke="#c9a227" stroke-width="2.4" stroke-linecap="round">
    <line x1="50" y1="32" x2="50" y2="37"/>
    <line x1="50" y1="63" x2="50" y2="68"/>
    <line x1="34" y1="50" x2="39" y2="50"/>
    <line x1="61" y1="50" x2="66" y2="50"/>
    <line x1="38" y1="38" x2="41" y2="41"/>
    <line x1="59" y1="59" x2="62" y2="62"/>
    <line x1="62" y1="38" x2="59" y2="41"/>
    <line x1="41" y1="59" x2="38" y2="62"/>
  </g>
  <circle cx="50" cy="50" r="5.5" fill="#f7f5ef"/>
  <!-- owl silhouette nod to 'A Watchful Messenger' -->
  <text x="50" y="55" font-size="9" text-anchor="middle" fill="#1c3f63" font-family="Georgia, serif" font-weight="bold">1670</text>
`}></svg>
