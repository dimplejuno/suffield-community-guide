---
// Themed SVG cover banner per category — self-contained, no external images.
const { cat, count } = Astro.props;

const motifs = {
  government: `
    <g fill="#ffffff" opacity="0.9">
      <rect x="330" y="60" width="120" height="10"/>
      <polygon points="390,30 460,60 320,60"/>
      <g><rect x="336" y="74" width="10" height="46"/><rect x="360" y="74" width="10" height="46"/><rect x="384" y="74" width="10" height="46"/><rect x="408" y="74" width="10" height="46"/><rect x="432" y="74" width="10" height="46"/></g>
      <rect x="322" y="122" width="140" height="10"/>
    </g>`,
  library: `
    <g opacity="0.92">
      <rect x="352" y="46" width="20" height="86" fill="#ffffff"/>
      <rect x="376" y="40" width="20" height="92" fill="#fbe7bf"/>
      <rect x="400" y="52" width="20" height="80" fill="#ffffff"/>
      <rect x="420" y="60" width="34" height="72" fill="#fbe7bf" transform="rotate(12 437 96)"/>
    </g>`,
  schools: `
    <g fill="#ffffff" opacity="0.92">
      <polygon points="390,44 460,72 320,72"/>
      <rect x="384" y="72" width="12" height="10"/>
      <circle cx="390" cy="90" r="4"/>
      <path d="M330 78 v34 a60 24 0 0 0 120 0 v-34" fill="none" stroke="#ffffff" stroke-width="6"/>
      <line x1="460" y1="72" x2="460" y2="104" stroke="#fbe7bf" stroke-width="3"/>
    </g>`,
  organizations: `
    <g fill="#ffffff" opacity="0.92">
      <path d="M390 128 C 360 104 340 90 340 70 a20 20 0 0 1 50 -6 a20 20 0 0 1 50 6 c0 20 -20 34 -50 58 Z" fill="#fbe7bf"/>
      <circle cx="356" cy="60" r="12" fill="#ffffff"/><circle cx="424" cy="60" r="12" fill="#ffffff"/>
    </g>`,
  history: `
    <g fill="#ffffff" opacity="0.92">
      <polygon points="388,40 452,74 324,74"/>
      <rect x="330" y="74" width="116" height="52"/>
      <rect x="352" y="90" width="18" height="36" fill="#c9a227"/>
      <rect x="406" y="90" width="18" height="36" fill="#c9a227"/>
      <rect x="380" y="86" width="16" height="16" fill="#c9a227"/>
    </g>`,
  farming: `
    <g opacity="0.95">
      <circle cx="418" cy="58" r="20" fill="#fbe7bf"/>
      <path d="M300 132 q60 -34 96 -6 q46 -34 100 4 v10 h-196 Z" fill="#ffffff"/>
      <g stroke="#fbe7bf" stroke-width="3" stroke-linecap="round">
        <line x1="344" y1="120" x2="344" y2="88"/><line x1="344" y1="98" x2="336" y2="92"/><line x1="344" y1="98" x2="352" y2="92"/>
        <line x1="360" y1="122" x2="360" y2="94"/><line x1="360" y1="104" x2="352" y2="98"/><line x1="360" y1="104" x2="368" y2="98"/>
      </g>
    </g>`,
  churches: `
    <g fill="#ffffff" opacity="0.92">
      <polygon points="388,26 404,58 372,58"/>
      <rect x="382" y="34" width="4" height="10"/><rect x="379" y="37" width="10" height="4"/>
      <rect x="372" y="58" width="32" height="70"/>
      <path d="M382 96 a6 6 0 0 1 12 0 v32 h-12 Z" fill="#c9a227"/>
      <rect x="340" y="86" width="30" height="42" fill="#ffffff"/><rect x="406" y="86" width="30" height="42" fill="#ffffff"/>
    </g>`,
};

const motif = motifs[cat.id] || '';
const gid = `cov-${cat.id}`;
---
<div class="cat-cover">
  <svg viewBox="0 0 480 150" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${cat.label} cover`} set:html={`
    <defs>
      <linearGradient id="${gid}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="${cat.hue}"/>
        <stop offset="1" stop-color="#1c3f63"/>
      </linearGradient>
    </defs>
    <rect width="480" height="150" fill="url(#${gid})"/>
    <g opacity="0.10" fill="#ffffff">
      <circle cx="60" cy="30" r="90"/><circle cx="470" cy="150" r="70"/>
    </g>
    ${motif}
  `}></svg>
  <span class="count">{count} {count === 1 ? 'listing' : 'listings'}</span>
  <div class="cover-label">
    <span class="ic">{cat.icon}</span>
    <h2 id={cat.id}>{cat.label}</h2>
  </div>
</div>
